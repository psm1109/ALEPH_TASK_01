DATABASE_URL=postgresql://[user]:[password]@[host]/[database]?sslmode=require
PASSKEY_RP_ID=example.com
PASSKEY_ORIGIN=https://example.com
PASSKEY_OWNER_NAME=owner
PASSKEY_USER_HANDLE=replace-with-a-stable-random-owner-handle
PASSKEY_SETUP_SECRET=replace-with-a-long-random-bootstrap-secret
SESSION_SECRET=replace-with-a-different-long-random-session-secret
CBOR_NATIVE_ACCELERATION_DISABLED=true
